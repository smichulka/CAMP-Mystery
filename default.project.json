{
  "name": "CAMP-Mystery",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Assets": {
        "$className": "Folder",
        "Images": {
          "$className": "Folder",
          "UI": {
            "$className": "Folder"
          }
        }
      },
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RoundStateChanged": {
          "$className": "RemoteEvent"
        },
        "GetRoundState": {
          "$className": "RemoteFunction"
        },
        "PlayerStateChanged": {
          "$className": "RemoteEvent"
        },
        "GetPlayerState": {
          "$className": "RemoteFunction"
        },
        "SubmitVote": {
          "$className": "RemoteEvent"
        },
        "GameStateChanged": {
          "$className": "RemoteEvent"
        },
        "GetGameState": {
          "$className": "RemoteFunction"
        },
        "RequestAction": {
          "$className": "RemoteFunction"
        },
        "Announcement": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "ServerAssets": {
        "$className": "Folder",
        "Maps": {
          "$className": "Folder"
        },
        "Monsters": {
          "$className": "Folder"
        },
        "NPCs": {
          "$className": "Folder"
        },
        "Items": {
          "$className": "Folder"
        },
        "Evidence": {
          "$className": "Folder"
        }
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "LoadingScreen": {
        "$path": "src/client/LoadingScreen.client.lua"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "GameUI": {
        "$className": "ScreenGui",
        "$properties": {
          "DisplayOrder": 10,
          "IgnoreGuiInset": false,
          "ResetOnSpawn": false
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Runtime": {
        "$className": "Folder",
        "Characters": {
          "$className": "Folder"
        },
        "Evidence": {
          "$className": "Folder"
        },
        "Effects": {
          "$className": "Folder"
        },
        "Map": {
          "$className": "Folder"
        }
      }
    }
  }
}
